rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource != null
                   && request.resource.size < 15 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)') ||
                     request.resource.contentType.matches('application/(json|vnd\\.ms-excel|vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)') ||
                     request.resource.contentType.matches('text/(csv|plain)')
                   );
    }
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
